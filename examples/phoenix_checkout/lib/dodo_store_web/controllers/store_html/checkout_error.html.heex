<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Checkout unavailable</title>
    <link rel="stylesheet" href={~p"/assets/app.css"} />
  </head>
  <body>
    <main class="shell checkout-state">
      <p class="eyebrow">Checkout unavailable</p>
      <h1>We could not create a checkout session</h1>
      <p class="error">
        We could not start checkout right now. Please try again, or contact
        support if the problem continues.
      </p>
      <a class="secondary-link" href={~p"/"}>Try again</a>
    </main>
  </body>
</html>
